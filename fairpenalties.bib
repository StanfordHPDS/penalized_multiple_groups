	file = {Full Text PDF:/Users/cnakss/Zotero/storage/3ZVBM7M8/Inoguchi et al. - 2022 - A simplified prediction model for end-stage kidney disease in patients with diabetes.pdf:application/pdf},
}

@article{su_machine_2022,
