	keywords = {Computer Science - Machine Learning, Mathematics - Optimization and Control, Computer Science - Neural and Evolutionary Computing},
	annote = {Comment: Published as a conference paper at ICLR 2019},
	file = {Preprint PDF:/Users/cnakss/Zotero/storage/6ADYUD6B/Loshchilov and Hutter - 2019 - Decoupled Weight Decay Regularization.pdf:application/pdf;Snapshot:/Users/cnakss/Zotero/storage/YQPYQAMC/1711.html:text/html},
}

