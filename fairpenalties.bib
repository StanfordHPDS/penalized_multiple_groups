	journal = {Scientific Reports},
	author = {Inoguchi, Toyoshi and Okui, Tasuku and Nojiri, Chinatsu and Eto, Erina and Hasuzawa, Nao and Inoguchi, Yukihiro and Ochi, Kentaro and Takashi, Yuichi and Hiyama, Fujiyo and Nishida, Daisuke and Umeda, Fumio and Yamauchi, Teruaki and Kawanami, Daiji and Kobayashi, Kunihisa and Nomura, Masatoshi and Nakashima, Naoki},
